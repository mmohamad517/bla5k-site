# Every variable here is read at BUILD time, so set them in the Cloudflare
# Pages project (Settings → Environment variables → Production) and redeploy.
# A variable left unset simply disables its feature — nothing breaks, but the
# corresponding script/markup is omitted from the built pages entirely.

# Cloudflare Web Analytics (free, privacy-first, cookieless)
# dash.cloudflare.com → Analytics & Logs → Web Analytics → select the site →
# copy the beacon token (32 hex chars).
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Google AdSense publisher id, format ca-pub-XXXXXXXXXXXXXXXX.
# WITHOUT THIS, NO AD CODE IS RENDERED ON ANY PAGE — ads.txt and a verified
# AdSense account are not enough on their own. Find it in AdSense →
# Account → Settings → Account information.
# Each <AdSlot slot="…"> also needs a real ad-unit id from
# AdSense → Ads → By ad unit; a placeholder id is skipped at build time.
PUBLIC_ADSENSE_CLIENT=

# Google Analytics 4 measurement id, format G-XXXXXXXXXX. Optional —
# Search Console and Cloudflare Web Analytics cover most of this.
PUBLIC_GA4_ID=
