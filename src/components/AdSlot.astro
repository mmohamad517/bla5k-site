---
// Google AdSense slot — GDPR-gated. The <ins> container renders inert and
// empty. The ad only fills when the visitor has ACCEPTED cookies: the
// adsbygoogle.js loader (injected by Layout's analytics-gate) is present AND
// this component pushes the slot to window.adsbygoogle. On "reject", nothing
// is pushed and no ad request ever fires.
// Requires: PUBLIC_ADSENSE_CLIENT env var + an ad-slot id from AdSense.
interface Props {
  slot: string; // e.g. '1234567890' — data-ad-slot from your AdSense unit
  format?: string; // 'auto' default, or 'horizontal'/'rectangle'
  className?: string;
}
import { ADSENSE_CLIENT } from '../lib/adsense';

const { slot, format = 'auto', className = '' } = Astro.props;
const adsenseClient = ADSENSE_CLIENT;
// A slot id of all zeros is the placeholder left in place before a real ad
// unit was created in AdSense. Rendering it shipped a dashed empty box on
// every tool and guide page that could never fill, so treat it as "no slot".
const slotReady = /^\d{6,}$/.test(slot) && !/^0+$/.test(slot);
if (adsenseClient && !slotReady) {
  console.warn(`[AdSlot] skipping ad: "${slot}" is not a real AdSense slot id — create the ad unit in AdSense and use its data-ad-slot value.`);
}
---
{adsenseClient && slotReady && (
  <div class={`adslot ${className}`} style="margin-block:2rem 0.5rem" aria-hidden="true">
    <ins
      class="adsbygoogle"
      style="display:block; border-radius:12px; overflow:hidden; background:rgba(112,243,255,.03); border:1px dashed var(--glass-border); min-height:90px;"
      data-ad-client={adsenseClient}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"
    />
    <script is:inline>
      // Queue the slot for AdSense. The loader in <head> processes queued
      // pushes once it arrives, so this runs for every visitor — gating the
      // push on consent left the slot permanently empty for Google's reviewer.
      // Whether the ad is personalised is decided by the consent message
      // configured in AdSense, plus the non-personalised default set in <head>.
      try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch {}
      // Once a visitor consents, drop the non-personalised default so later
      // page views can serve personalised ads.
      document.addEventListener('bla5k-consent', (e) => {
        if (e.detail === 'accept') {
          try { delete window.adsbygoogle.requestNonPersonalizedAds; } catch {}
        }
      });
    </script>
  </div>
)}
