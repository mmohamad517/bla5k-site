---
// Google AdSense slot — GDPR-gated. The <ins> container renders inert and
// empty. The ad only fills when the visitor has ACCEPTED cookies: the
// adsbygoogle.js loader (injected by Layout's analytics-gate) is present AND
// this component pushes the slot to window.adsbygoogle. On "reject", nothing
// is pushed and no ad request ever fires.
// Requires: PUBLIC_ADSENSE_CLIENT env var + an ad-slot id from AdSense.
interface Props {
  slot: string; // e.g. '1234567890' — data-ad-slot from your AdSense unit
  format?: string; // 'auto' default, or 'horizontal'/'rectangle'
  className?: string;
}
const { slot, format = 'auto', className = '' } = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---
{adsenseClient && (
  <div class={`adslot ${className}`} style="margin-block:2rem 0.5rem" aria-hidden="true">
    <ins
      class="adsbygoogle"
      style="display:block; border-radius:12px; overflow:hidden; background:rgba(112,243,255,.03); border:1px dashed var(--glass-border); min-height:90px;"
      data-ad-client={adsenseClient}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"
    />
    <script is:inline>
      // Only push the slot to AdSense when the visitor accepted cookies.
      // If consent is rejected, the loader never exists and this slot stays
      // empty — no ad request is ever made (GDPR/ePrivacy compliance).
      const KEY = 'bla5k-cookie-consent', VER = '1';
      const readChoice = () => {
        try {
          const o = JSON.parse(localStorage.getItem(KEY) || 'null');
          return o && o.version === VER ? o.choice : null;
        } catch { return null; }
      };
      // Push unconditionally into the queued array — adsbygoogle.js (injected
      // by Layout's deferred module gate) processes queued pushes once it
      // loads. Gating on window.adsbygoogle existence here would break
      // stored-accept visits, since this classic script runs BEFORE the
      // deferred module gate executes.
      const push = () => {
        if (readChoice() !== 'accept') return;
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch {}
      };
      if (readChoice() === 'accept') push();
      // If the visitor accepts AFTER the page rendered, fill the slot too.
      document.addEventListener('bla5k-consent', (e) => { if (e.detail === 'accept') push(); });
    </script>
  </div>
)}
