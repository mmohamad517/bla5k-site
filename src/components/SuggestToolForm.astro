---
// Submit-a-tool form — powered by Web3Forms (free), the same system as the
// newsletter box. Submissions land in your inbox for editorial review.
//
// TO ACTIVATE: get a free access key at https://web3forms.com → paste it
// below (you can reuse the same key as the newsletter box). Until then the
// form stays hidden so nothing broken ever goes live — the review guide
// below is always visible.
import { subcategories } from '../data/categories';
import { WEB3FORMS_KEY, web3FormsReady as emailReady } from '../lib/config';

// Contact email shown in the offline note — passed from the page so it can't drift.
interface Props {
  email?: string;
}
const { email = 'mmohamad517@gmail.com' } = Astro.props;
---

<section class="suggest glass" id="suggest">
  <div class="suggest-head">
    <h2>Suggest a tool</h2>
    <p>
      Know a website, tool, or community that deserves a spot in the directory? Send it our way —
      every submission is hand-reviewed by the editorial team before it goes live.
    </p>
  </div>

  {emailReady ? (
    <form id="toolForm" class="suggest-form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="New bla5k tool submission" />
      <input type="hidden" name="from_name" value="bla5k — Tool Submission" />
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="field">
        <label for="t-name">Tool / site name <span class="req">*</span></label>
        <input id="t-name" name="tool_name" type="text" required maxlength="60" placeholder="e.g. Acme AI" />
      </div>

      <div class="field">
        <label for="t-url">Website URL <span class="req">*</span></label>
        <input id="t-url" name="tool_url" type="url" required placeholder="https://…" />
      </div>

      <div class="field-row">
        <div class="field">
          <label for="t-cat">Category</label>
          <select id="t-cat" name="category">
            <option value="">— Choose one (optional) —</option>
            {subcategories.map((s) => <option value={s.slug}>{s.name}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="t-price">Pricing model</label>
          <select id="t-price" name="pricing">
            <option value="">Not sure</option>
            <option value="free">Free</option>
            <option value="freemium">Freemium</option>
            <option value="paid">Paid</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="t-tag">One-line description <span class="req">*</span></label>
        <input id="t-tag" name="tagline" type="text" required maxlength="140" placeholder="What it does, in one clear sentence" />
      </div>

      <div class="field">
        <label for="t-why">Why it deserves a spot</label>
        <textarea id="t-why" name="why" rows="4" maxlength="500" placeholder="A sentence or two on what makes it genuinely good…"></textarea>
      </div>

      <div class="field">
        <label for="t-email">Your email <span class="muted">(optional — only if we need to follow up)</span></label>
        <input id="t-email" name="email" type="email" placeholder="you@example.com" />
      </div>

      <button type="submit" class="btn btn-primary">Submit for review</button>
      <p class="form-msg" id="toolMsg" role="status" aria-live="polite"></p>
    </form>
  ) : (
    <p class="offline-note">🛠️ The submission form is being wired up — meanwhile, email us your suggestion at <a href={`mailto:${email}?subject=Tool%20suggestion`}>{email}</a>.</p>
  )}

  <div class="review-guide">
    <h3>What happens next</h3>
    <ol>
      <li><strong>Review:</strong> our editors check every submission, usually within 1–3 days.</li>
      <li><strong>Criteria:</strong> it must be a real, working product — no broken links, spam, or placeholder pages.</li>
      <li><strong>Policy:</strong> we don't list gambling, drugs, piracy, or anything making medical claims. We comply with Google's webmaster guidelines.</li>
      <li><strong>Approval:</strong> accepted tools get a full page with a plain-language explainer, honest pros/cons, and FAQ.</li>
      <li><strong>Paid boost:</strong> want guaranteed placement and a featured slot faster? See our <a href="/advertise/">advertising packages</a>.</li>
    </ol>
  </div>
</section>

<style>
  .suggest { padding: clamp(1.4rem, 3vw, 2rem); margin: 2rem 0; }
  .suggest-head h2 { font-family: var(--font-head); font-size: 1.35rem; margin-bottom: 0.4rem; }
  .suggest-head p { color: var(--text-dim); font-size: 0.98rem; max-width: 56ch; margin-bottom: 1.2rem; }

  .suggest-form { display: grid; gap: 0.9rem; }
  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field-row { display: grid; grid-template-columns: 1fr; gap: 0.9rem; }
  .field label { font-size: 0.85rem; font-weight: 600; color: var(--text); }
  .field label .req { color: var(--orange); }
  .field label .muted { color: var(--text-faint); font-weight: 400; }
  .field input,
  .field select,
  .field textarea {
    background: rgba(18,22,41,.6); color: var(--text);
    border: 1px solid var(--glass-border-strong); border-radius: 12px;
    padding: 0.7rem 0.85rem; font: inherit; width: 100%;
    transition: border-color .2s, box-shadow .2s;
  }
  .field select option { background: #141a30; color: var(--text); }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible { outline: 2px solid var(--cyan); outline-offset: 1px; }
  .field textarea { resize: vertical; min-height: 84px; }
  .field input::placeholder, .field textarea::placeholder { color: var(--text-faint); }
  .hp { position: absolute; left: -9999px; opacity: 0; }
  .suggest-form .btn { justify-self: start; }
  .form-msg { font-size: 0.92rem; color: var(--cyan-soft); min-height: 1.2em; margin-top: 0.2rem; }

  .offline-note { color: var(--text-dim); font-size: 0.95rem; margin-bottom: 1.2rem; }
  .offline-note a { color: var(--cyan-soft); text-decoration: underline; text-underline-offset: 3px; }

  .review-guide {
    margin-top: 1.6rem; padding-top: 1.4rem;
    border-top: 1px solid rgba(112,243,255,.1);
  }
  .review-guide h3 { font-family: var(--font-head); font-size: 1.05rem; margin-bottom: 0.6rem; }
  .review-guide ol { display: grid; gap: 0.45rem; list-style-position: inside; color: var(--text-dim); font-size: 0.94rem; }
  .review-guide li::marker { color: var(--cyan-soft); font-weight: 700; }
  .review-guide a { color: var(--cyan-soft); text-decoration: underline; text-underline-offset: 3px; }

  @media (min-width: 640px) { .field-row { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  const f = document.getElementById('toolForm') as HTMLFormElement | null;
  if (f) {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('toolMsg');
      const data = Object.fromEntries(new FormData(f) as any);
      if (msg) msg.textContent = 'Submitting…';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (msg) msg.textContent = json.success
          ? '✅ Thanks! Your suggestion is in our review queue — we usually reply within 1–3 days.'
          : 'Hmm, that didn\'t go through — please try again.';
        if (json.success) f.reset();
      } catch {
        if (msg) msg.textContent = 'Network error — please try again in a moment.';
      }
    });
  }
</script>
