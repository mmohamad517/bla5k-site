---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  heading: string;
  updated?: string;
  noindex?: boolean;
}
const { title, description, heading, updated, noindex = false } = Astro.props;
---
<Layout title={`${title} | bla5k`} description={description} noindex={noindex}>
  <Header />
  <main>
    <article class="page">
      <div class="container">
        <h1 class="page-title">{heading}</h1>
        {updated && <p class="page-updated">Last updated: {updated}</p>}
        <div class="prose">
          <slot />
        </div>
        <p class="back"><a href="/">← Back to home</a></p>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .page { padding-block: clamp(2rem, 6vw, 3.5rem); }
  .container { max-width: 780px; }
  .page-title { font-size: clamp(1.9rem, 1.4rem + 3vw, 2.8rem); }
  .page-updated { color: var(--text-faint); font-size: 0.85rem; margin-top: 0.6rem; }
  .prose { margin-top: 1.8rem; }
  .prose :global(h2) { font-size: 1.4rem; margin-top: 2rem; margin-bottom: 0.6rem; }
  .prose :global(h3) { font-size: 1.15rem; margin-top: 1.4rem; margin-bottom: 0.4rem; }
  .prose :global(p) { color: var(--text-dim); margin-bottom: 1rem; }
  .prose :global(ul) { padding-left: 1.2rem; margin-bottom: 1rem; display: grid; gap: 0.4rem; }
  .prose :global(li) { color: var(--text-dim); }
  .prose :global(a) { color: var(--cyan-soft); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(strong) { color: var(--text); }
  .back { margin-top: 2.4rem; }
  .back a { color: var(--cyan-soft); font-weight: 600; }
</style>
