---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Best2026 from '../components/Best2026.astro';
import NewestTools from '../components/NewestTools.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import Footer from '../components/Footer.astro';

// Homepage schema stays light (WebSite/Organization come from the Layout base
// graph). The full ItemList of every tool lives on /directory/ — rendering
// 2,700+ entries inline here made the homepage HTML ~4.8 MB.
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': 'https://bla5k.com/',
    name: 'The bla5k Directory',
    description: 'A curated directory of the best AI tools, websites, and communities.',
    isPartOf: { '@id': 'https://bla5k.com/#website' },
  },
];
---
<Layout schema={schema}>
  <Header />
  <main>
    <Hero />
    <ProductCard />
    <Best2026 />
    <NewestTools />
    <CategoryGrid />
  </main>
  <Footer />
</Layout>
