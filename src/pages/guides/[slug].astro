---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection, render } from 'astro:content';
import { categoryBySlug } from '../../data/categories';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const site = 'https://bla5k.com';

const words = entry.body ? entry.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.round(words / 220));
const cat = d.category ? categoryBySlug(d.category) : undefined;
const toc = headings.filter((h) => h.depth === 2);
const fmt = (dt: Date) => dt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/guides/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: `${site}/guides/${entry.id}/` },
    ],
  },
  {
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    author: { '@type': 'Organization', name: d.author },
    publisher: { '@id': `${site}/#org` },
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    mainEntityOfPage: `${site}/guides/${entry.id}/`,
    image: `${site}/og-image.png`,
    wordCount: words,
  },
  ...(d.faqs && d.faqs.length > 0
    ? [{
        '@type': 'FAQPage',
        mainEntity: d.faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }]
    : []),
];
---
<Layout title={d.metaTitle ?? `${d.title} | bla5k`} description={d.description} schema={schema}>
  <Header />
  <main>
    <article class="guide">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span>
          <a href="/guides/">Guides</a> <span aria-hidden="true">/</span>
          <span>{d.title}</span>
        </nav>

        <header class="guide-head">
          {cat && <a class="g-cat" href={`/category/${cat.slug}/`}>{cat.icon} {cat.name}</a>}
          <h1 class="guide-title">{d.title}</h1>
          <p class="guide-desc">{d.description}</p>
          <div class="guide-meta">
            <span>By {d.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={d.published.toISOString()}>{fmt(d.published)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime} min read</span>
          </div>
        </header>

        <div class="guide-layout">
          {toc.length > 2 && (
            <aside class="toc" aria-label="Table of contents">
              <p class="toc-title">On this page</p>
              <ul>
                {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              </ul>
            </aside>
          )}
          <div class="prose">
            <Content />
          </div>
        </div>

        {/* AdSense slot — replace "0000000000" with a real data-ad-slot from your AdSense ad unit before enabling PUBLIC_ADSENSE_CLIENT */}
        <AdSlot slot="0000000000" className="ad-in-content" />

        <p class="back"><a href="/guides/">← All guides</a></p>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .guide { padding-block: clamp(1.5rem, 5vw, 2.5rem) clamp(2rem, 6vw, 3.5rem); }
  .crumbs { font-size: 0.85rem; color: var(--text-faint); margin-bottom: 1.4rem; }
  .crumbs a { color: var(--cyan-soft); }
  .crumbs span { margin-inline: 0.35rem; }

  .guide-head { max-width: 760px; }
  .g-cat { font-family: var(--font-head); font-weight: 600; font-size: 0.85rem; color: var(--cyan-soft); }
  .guide-title { font-size: clamp(2rem, 1.4rem + 4vw, 3.2rem); margin-block: 0.6rem 0.8rem; line-height: 1.12; }
  .guide-desc { color: var(--text-dim); font-size: 1.15rem; }
  .guide-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; color: var(--text-faint); font-size: 0.9rem; margin-top: 1rem; }

  .guide-layout { display: grid; gap: 2rem; margin-top: 2.4rem; }

  .toc { align-self: start; }
  .toc-title { font-family: var(--font-head); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 0.8rem; }
  .toc ul { list-style: none; display: grid; gap: 0.5rem; border-left: 1px solid var(--glass-border); padding-left: 1rem; }
  .toc a { color: var(--text-dim); font-size: 0.92rem; transition: color .2s; }
  .toc a:hover { color: var(--cyan-soft); }

  /* Prose */
  .prose { max-width: 72ch; color: var(--text); font-size: 1.06rem; }
  .prose :global(h2) { font-size: 1.7rem; margin-top: 2.4rem; margin-bottom: 0.8rem; scroll-margin-top: 80px; }
  .prose :global(h3) { font-size: 1.3rem; margin-top: 1.8rem; margin-bottom: 0.5rem; }
  .prose :global(p) { color: var(--text-dim); margin-bottom: 1.1rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; margin-bottom: 1.1rem; display: grid; gap: 0.5rem; }
  .prose :global(li) { color: var(--text-dim); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(a) { color: var(--cyan-soft); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(blockquote) { border-left: 3px solid var(--cyan); padding: 0.6rem 1.1rem; margin: 1.4rem 0; background: rgba(0,240,255,.05); border-radius: 0 10px 10px 0; color: var(--text-dim); }
  .prose :global(h2 + p) { margin-top: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.2rem 0; font-size: 0.95rem; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--glass-border); padding: 0.6rem 0.8rem; text-align: left; }
  .prose :global(th) { color: var(--text); font-family: var(--font-head); background: rgba(112,243,255,.05); }
  .prose :global(td) { color: var(--text-dim); }
  .prose :global(hr) { border: none; border-top: 1px solid var(--glass-border); margin: 2rem 0; }

  .back { margin-top: 2.6rem; }
  .back a { color: var(--cyan-soft); font-weight: 600; }

  @media (min-width: 940px) {
    .guide-layout { grid-template-columns: 220px 1fr; gap: 3rem; }
    .toc { position: sticky; top: 80px; }
  }
</style>
