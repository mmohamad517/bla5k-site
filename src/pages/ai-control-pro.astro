---
import Layout from '../layouts/Layout.astro';

const title = 'CODE WITH US UNLIMITED FOR FREE — AI Automation Software | bla5k';
const description =
  'Turn your computer into an automation beast working 24/7 — full desktop control, web browsing, app building, and code fixing with zero token limits.';
const BUY = 'https://shop.beacons.ai/newbook.00/f41a4025-b4ae-48a8-b0bf-91293bee5057';
---
<Layout title={title} description={description}>
  <main class="lp">
    <!-- Ambient glowing backgrounds -->
    <div class="neon-glow-bg glow-1" aria-hidden="true"></div>
    <div class="neon-glow-bg glow-2" aria-hidden="true"></div>
    <div class="neon-glow-bg glow-3" aria-hidden="true"></div>
    <div class="neon-glow-bg glow-4" aria-hidden="true"></div>

    <div class="container">
      <!-- HERO -->
      <section class="hero-grid">
        <div class="hero-content">
          <span class="badge-glow">⚡ CODE WITH US · PRO · UNLIMITED FOR FREE</span>
          <h1>
            Turn Your Computer into an <br />
            <span class="gradient-pink">Automation Beast Working 24/7</span>
          </h1>
          <p>
            An AI tool that takes full control of your desktop, browses the web, builds mobile apps and websites,
            and fixes code with zero token limits!
          </p>
          <a href={BUY} target="_blank" rel="noopener noreferrer" class="cta-btn">
            Get Instant Access
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- STATIC IPHONE FRAME (dynamic animations inside only) -->
        <div class="iphone-frame">
          <div class="iphone-screen" id="iphoneScreen"></div>
        </div>
      </section>

      <!-- 10 CORE FEATURES -->
      <section class="section-spacer">
        <h2 class="section-title">Superhero Capabilities <span class="gradient-cyan">Executed Automatically</span></h2>
        <p class="sec-sub">Everything you need executed with unmatched precision:</p>

        <div class="features-grid">
          <div class="glass-card glass-card-pink feature-box">
            <div class="icon-wrap" style="color: #ff007f"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg></div>
            <h3>1. Full Computer Control</h3>
            <p>Opens, closes, and navigates any desktop software on your behalf seamlessly.</p>
          </div>
          <div class="glass-card glass-card-cyan feature-box">
            <div class="icon-wrap" style="color: #00f0ff"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></div>
            <h3>2. Complete Web Browsing</h3>
            <p>Navigates any website, reads data, and performs web actions just like a human.</p>
          </div>
          <div class="glass-card glass-card-green feature-box">
            <div class="icon-wrap" style="color: #10b981"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg></div>
            <h3>3. Download &amp; Organize Anything</h3>
            <p>Downloads games, large media files, and documents, automatically organizing them.</p>
          </div>
          <div class="glass-card glass-card-pink feature-box">
            <div class="icon-wrap" style="color: #ff007f"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></div>
            <h3>4. Code Writing &amp; Bug Fixing</h3>
            <p>Develops apps, writes clean code, detects bugs, and patches them with a single click.</p>
          </div>
          <div class="glass-card glass-card-cyan feature-box">
            <div class="icon-wrap" style="color: #00f0ff"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
            <h3>5. Continuous 24/7 Execution</h3>
            <p>Set tasks, go to sleep, and wake up to find your projects fully finished.</p>
          </div>
          <div class="glass-card glass-card-green feature-box">
            <div class="icon-wrap" style="color: #10b981"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z"/></svg></div>
            <h3>6. Zero Token &amp; Usage Limits</h3>
            <p>Unlimited operation without rate limits or annoying "usage limit reached" warnings.</p>
          </div>
          <div class="glass-card glass-card-pink feature-box">
            <div class="icon-wrap" style="color: #ff007f"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg></div>
            <h3>7. Builds Apps &amp; Websites</h3>
            <p>Generates full Android/iOS apps and websites ready for store deployment and sale.</p>
          </div>
          <div class="glass-card glass-card-green feature-box">
            <div class="icon-wrap" style="color: #10b981"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
            <h3>8. Revenue Engine</h3>
            <p>Builds stores, acquires clients, and automates freelance gigs to generate real income.</p>
          </div>
          <div class="glass-card glass-card-cyan feature-box">
            <div class="icon-wrap" style="color: #00f0ff"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.9 2.6 11.3 6a1.5 1.5 0 0 0 .7.7l3.4 1.4a.5.5 0 0 1 0 .9L12 10.4a1.5 1.5 0 0 0-.7.7L9.9 14.6a.5.5 0 0 1-.9 0L7.6 11.1a1.5 1.5 0 0 0-.7-.7L3.5 9a.5.5 0 0 1 0-.9L6.9 6.7a1.5 1.5 0 0 0 .7-.7l1.4-3.4a.5.5 0 0 1 .9 0Z"/><path d="M18.4 14.5 19 16l1.5.6a.4.4 0 0 1 0 .8L19 18l-.6 1.5a.4.4 0 0 1-.8 0L17 18l-1.5-.6a.4.4 0 0 1 0-.8L17 16l.6-1.5a.4.4 0 0 1 .8 0Z"/></svg></div>
            <h3>9. Expandable Skillset</h3>
            <p>Easily teach it new custom workflows and watch it execute them instantly.</p>
          </div>
          <div class="glass-card glass-card-pink feature-box">
            <div class="icon-wrap" style="color: #ff007f"><svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg></div>
            <h3>10. All-in-One Digital Workforce</h3>
            <p>Replaces 10 developers and admins without requiring any monthly salary.</p>
          </div>
        </div>
      </section>

      <!-- TARGET AUDIENCE -->
      <section class="section-spacer">
        <h2 class="section-title">Who Is This <span class="gradient-pink">Designed For?</span></h2>
        <p class="aud-hl">🌟 Designed for Everyone Without Exception!</p>

        <div class="audience-grid">
          <div class="glass-card">
            <h3 style="color: #00f0ff; margin-bottom: 10px;">For Beginners &amp; Non-Techies</h3>
            <p>Zero technical knowledge needed. Simply prompt the tool in plain English and let it handle everything.</p>
          </div>
          <div class="glass-card">
            <h3 style="color: #ff007f; margin-bottom: 10px;">For Students &amp; Academics</h3>
            <p>Automate research, organize files, summarize textbooks, and handle repetitive academic tasks effortlessly.</p>
          </div>
          <div class="glass-card">
            <h3 style="color: #10b981; margin-bottom: 10px;">For Entrepreneurs &amp; Hustlers</h3>
            <p>Launch digital businesses, mobile apps, and e-commerce stores to scale revenue streams with minimal effort.</p>
          </div>
          <div class="glass-card">
            <h3 style="color: #00f0ff; margin-bottom: 10px;">For Developers &amp; Professionals</h3>
            <p>Speed up coding workflows 10x, automate server deployments, and eliminate mundane operational tasks.</p>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="section-spacer">
        <h2 class="section-title">Frequently Asked <span class="gradient-gold">Questions</span></h2>

        <div class="faq-list">
          <div class="glass-card faq-item">
            <h3><span class="qic">?</span> Are there any token or daily execution limits?</h3>
            <p>None at all. The system runs completely unlimited 24/7 without rate-limiting or artificial token caps.</p>
          </div>
          <div class="glass-card faq-item">
            <h3><span class="qic">?</span> How does it protect my privacy and data?</h3>
            <p>It executes locally on your hardware, ensuring all your source codes, files, and data remain strictly private.</p>
          </div>
          <div class="glass-card faq-item">
            <h3><span class="qic">?</span> How can this tool generate revenue for me?</h3>
            <p>By automating the development of app store products, setting up automated e-commerce stores, scraping targeted sales leads, and completing freelance jobs.</p>
          </div>
          <div class="glass-card faq-item">
            <h3><span class="qic">?</span> Do I need coding experience to use it?</h3>
            <p>No prior technical experience required. You give instructions in plain language, and the AI executes mouse, keyboard, and code operations.</p>
          </div>
          <div class="glass-card faq-item">
            <h3><span class="qic">?</span> How is this different from Claude Code or ChatGPT?</h3>
            <p>Unlike text-only chatbots, this system actively controls your browser, mouse, terminal, and desktop software to perform real-world tasks.</p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section id="buy" class="cta-sec">
        <div class="glass-card glass-card-pink cta-card">
          <h2>Ready to Scale Your Automation and Take Control?</h2>
          <p>Get your hands on the ultimate autonomous AI tool and eliminate monthly salaries.</p>
          <a href={BUY} target="_blank" rel="noopener noreferrer" class="cta-btn">
            Get Started Now
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </a>
        </div>
      </section>
    </div>
  </main>

  <script>
    // Dynamic non-repeating payment notifications inside the iPhone
    const firstNames = ['James', 'Daniel', 'Robert', 'Liam', 'Ethan', 'Noah', 'Oliver', 'Lucas', 'Alexander', 'Mason'];
    const lastNames = ['Smith', 'Johnson', 'Williams', 'Brown', 'Jones', 'Garcia', 'Miller', 'Davis', 'Rodriguez', 'Martinez'];
    const projectTypes = [
      'Shopify Store Creation',
      'iOS App In-App Revenue',
      'Android App Ad Revenue',
      'Lead Generation Data Pack',
      'Freelance Python Automation',
      'Custom AI Tool Build',
      'Full Web Upload & Deploy',
      'SaaS System Bug Repair',
    ];

    const screen = document.getElementById('iphoneScreen');

    function pushNotification() {
      const fn = firstNames[Math.floor(Math.random() * firstNames.length)];
      const ln = lastNames[Math.floor(Math.random() * lastNames.length)];
      const emailNumber = Math.floor(Math.random() * 89) + 10;
      const email = `${fn.toLowerCase()}.${ln.toLowerCase()}${emailNumber}@gmail.com`;
      const project = projectTypes[Math.floor(Math.random() * projectTypes.length)];
      const amount = Math.floor(Math.random() * 75) * 10 + 120 + '.00';

      const n = document.createElement('div');
      n.className = 'stripe-alert';
      n.innerHTML = `
        <div class="stripe-icon">S</div>
        <div class="stripe-info">
          <div class="top"><span>STRIPE DIRECT</span><span>just now</span></div>
          <div class="email">${email}</div>
          <div class="desc">${project}</div>
          <div class="price">+$${amount} USD</div>
        </div>`;

      screen.insertBefore(n, screen.firstChild);
      if (screen.children.length > 5) screen.lastChild.remove();
    }

    pushNotification();
    setInterval(pushNotification, 2500);
  </script>

<style>
  .lp {
    --bg-color: #030008;
    --stripe-purple: #635bff;
    --neon-pink: #ff007f;
    --neon-cyan: #00f0ff;
    --neon-purple: #8a2be2;
    --neon-green: #10b981;
    position: relative;
    background: var(--bg-color);
    color: #fff;
    line-height: 1.6;
    padding-bottom: 80px;
    overflow-x: hidden;
    font-family: var(--font-body);
    min-height: 100dvh;
  }

  /* Ambient glowing backgrounds */
  .neon-glow-bg {
    position: absolute;
    width: 550px;
    height: 550px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.35;
    pointer-events: none;
    z-index: 0;
  }
  .glow-1 { top: 0; right: -10%; background: var(--neon-pink); }
  .glow-2 { top: 30%; left: -10%; background: var(--neon-cyan); }
  .glow-3 { top: 60%; right: 5%; background: var(--neon-purple); }
  .glow-4 { bottom: 0; left: 10%; background: var(--neon-green); }

  .lp :global(.container) { max-width: 1200px; margin: 0 auto; padding: 0 20px; position: relative; z-index: 1; }

  /* Glassmorphism radiant cards */
  .glass-card {
    background: rgba(18, 10, 36, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 25px;
    box-shadow: 0 0 25px rgba(138, 43, 226, 0.2);
    position: relative;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .glass-card:hover { border-color: var(--neon-cyan); box-shadow: 0 0 30px rgba(0, 240, 255, 0.3); }
  .glass-card-pink { border-color: rgba(255, 0, 127, 0.5); box-shadow: 0 0 25px rgba(255, 0, 127, 0.25); }
  .glass-card-cyan { border-color: rgba(0, 240, 255, 0.5); box-shadow: 0 0 25px rgba(0, 240, 255, 0.25); }
  .glass-card-green { border-color: rgba(16, 185, 129, 0.5); box-shadow: 0 0 25px rgba(16, 185, 129, 0.25); }

  /* Radiant headers & text */
  .section-title {
    font-size: 2.8rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 15px;
    color: #fff;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
    line-height: 1.3;
  }
  .gradient-pink {
    background: linear-gradient(90deg, #ff007f, #ff75c3);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .gradient-cyan {
    background: linear-gradient(90deg, #00f0ff, #70a2ff);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .gradient-gold {
    background: linear-gradient(90deg, #ffd700, #ff8c00);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .badge-glow {
    display: inline-block;
    padding: 8px 22px;
    border-radius: 30px;
    background: rgba(255, 0, 127, 0.2);
    border: 1px solid var(--neon-pink);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    box-shadow: 0 0 15px rgba(255, 0, 127, 0.4);
    margin-bottom: 20px;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: linear-gradient(90deg, var(--neon-pink), var(--neon-purple), var(--neon-cyan));
    color: #fff;
    font-size: 1.3rem;
    font-weight: 800;
    padding: 20px 50px;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 0 35px rgba(255, 0, 127, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.4);
    margin-top: 30px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .cta-btn:hover { transform: translateY(-2px); box-shadow: 0 0 45px rgba(255, 0, 127, 0.8); }

  /* Hero layout */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 80px 0;
  }
  .hero-content h1 { font-size: 3.2rem; font-weight: 800; line-height: 1.25; margin-bottom: 20px; }
  .hero-content p { font-size: 1.25rem; color: #d1d5db; margin-bottom: 30px; }

  /* iPhone display container */
  .iphone-frame {
    width: 320px;
    height: 640px;
    background: #000;
    border-radius: 48px;
    border: 4px solid #333;
    box-shadow: 0 0 40px rgba(0, 240, 255, 0.3), 0 0 80px rgba(255, 0, 127, 0.2);
    margin: 0 auto;
    position: relative;
    padding: 12px;
  }
  .iphone-frame::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 90px;
    height: 25px;
    background: #000;
    border-radius: 20px;
    z-index: 10;
  }
  .iphone-screen {
    width: 100%;
    height: 100%;
    background: #090a10;
    border-radius: 38px;
    padding: 55px 10px 15px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    position: relative;
  }

  /* Notifications inside iPhone only (created by JS at runtime) */
  :global(.stripe-alert) {
    background: rgba(255, 255, 255, 0.98);
    border-radius: 14px;
    padding: 10px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: #0f172a;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
    animation: phoneSlide 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
  :global(@keyframes phoneSlide) {
    from { opacity: 0; transform: translateY(-20px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  :global(.stripe-icon) {
    background: var(--stripe-purple);
    color: #fff;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 12px;
    flex-shrink: 0;
  }
  :global(.stripe-info) { display: flex; flex-direction: column; flex-grow: 1; }
  :global(.stripe-info .top) {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    color: #64748b;
    font-weight: 700;
  }
  :global(.stripe-info .email) { font-size: 10px; font-weight: 700; color: #1e293b; }
  :global(.stripe-info .desc) { font-size: 10px; color: #475569; }
  :global(.stripe-info .price) { font-size: 11px; font-weight: 800; color: var(--neon-green); }

  /* Grids */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 25px;
    margin-top: 40px;
  }
  .feature-box { display: flex; flex-direction: column; gap: 12px; }
  .feature-box .icon-wrap {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .feature-box h3 { font-size: 1.3rem; color: #fff; }
  .feature-box p { color: #a1a1aa; font-size: 0.95rem; }

  .sec-sub { text-align: center; color: #a1a1aa; font-size: 1.1rem; }
  .aud-hl { text-align: center; color: var(--neon-cyan); font-size: 1.4rem; font-weight: 700; margin-bottom: 20px; }
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .audience-grid p { color: #d1d5db; font-size: 0.98rem; }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 900px;
    margin: 40px auto 0;
  }
  .faq-item h3 {
    font-size: 1.2rem;
    color: var(--neon-cyan);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .qic {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-purple));
    box-shadow: 0 0 12px rgba(255, 0, 127, 0.5);
  }
  .faq-item p { color: #d1d5db; font-size: 1rem; }

  .section-spacer { padding: 80px 0; }

  /* Final CTA */
  .cta-sec { text-align: center; padding: 60px 0; }
  .cta-card { max-width: 850px; margin: 0 auto; }
  .cta-card h2 { font-size: 2.3rem; margin-bottom: 15px; }
  .cta-card p { color: #d1d5db; margin-bottom: 25px; }
  .cta-card .cta-btn { margin-top: 0; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-content h1 { font-size: 2.2rem; }
    .iphone-frame { margin-top: 30px; }
    .section-title { font-size: 2.2rem; }
    .cta-btn { padding: 18px 38px; font-size: 1.15rem; }
  }
