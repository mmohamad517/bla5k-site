---
import Page from '../layouts/Page.astro';
// Contact email shown plainly — AdSense review requires an accessible contact method
// without JavaScript (automated reviewers may not execute JS).
const email = 'mmohamad517@gmail.com';
---
<Page
  title="Contact"
  heading="Contact us"
  description="Get in touch with the bla5k team."
>
  <p>
    We’d love to hear from you — whether you want to suggest a tool for the directory,
    report a broken link, or ask about advertising and partnerships.
  </p>

  <h2>Email</h2>
  <p>
    Reach us directly by email at{' '}
    <a id="cemail" href={`mailto:${email}`}>{email}</a> — we read every message.
  </p>

  <h2>Suggest a tool</h2>
  <p>
    Know a website, tool, or forum that deserves a spot? Reach out with the link and a line
    about why it’s great, and we’ll take a look.
  </p>

  <h2>Advertising</h2>
  <p>
    Want to promote your product? See our <a href="/advertise/">advertising packages</a> to
    get featured on bla5k.
  </p>

</Page>
