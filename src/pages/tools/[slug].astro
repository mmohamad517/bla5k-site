---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { subcategoryBySlug, categoryBySlug } from '../../data/categories';
import { outboundRel } from '../../lib/links';

export async function getStaticPaths() {
  const sites = await getCollection('sites');
  return sites.map((entry) => ({ params: { slug: entry.id }, props: { entry, sites } }));
}

const { entry, sites } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const sub = subcategoryBySlug(d.subcategory);
const cat = sub ? categoryBySlug(sub.category) : undefined;
const site = 'https://bla5k.com';

const words = entry.body ? entry.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.round(words / 220));
const toc = headings.filter((h) => h.depth === 2);

const related = sites
  .filter((s) => s.id !== entry.id && s.data.subcategory === d.subcategory)
  .slice(0, 4);

const title = d.metaTitle ?? `${d.name} — Review & Guide | bla5k`;
const description = d.metaDescription ?? d.tagline;
const imageUrl = d.image ? (d.image.startsWith('http') ? d.image : `${site}${d.image}`) : `${site}/og-image.png`;

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      cat && { '@type': 'ListItem', position: 2, name: cat.name, item: `${site}/category/${cat.slug}/` },
      { '@type': 'ListItem', position: 3, name: d.name, item: `${site}/tools/${entry.id}/` },
    ].filter(Boolean),
  },
  {
    '@type': 'SoftwareApplication',
    name: d.name,
    url: d.url,
    applicationCategory: cat?.name,
    description: d.tagline,
    image: imageUrl,
    operatingSystem: 'All',
  },
  {
    '@type': 'Article',
    headline: title,
    description,
    author: { '@type': 'Organization', name: 'bla5k' },
    publisher: { '@id': `${site}/#org` },
    datePublished: (d.updated ?? new Date()).toISOString(),
    dateModified: (d.updated ?? new Date()).toISOString(),
    mainEntityOfPage: `${site}/tools/${entry.id}/`,
    image: imageUrl,
    wordCount: words,
  },
  ...(d.faqs && d.faqs.length > 0
    ? [{
        '@type': 'FAQPage',
        mainEntity: d.faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }]
    : []),
];
---
<Layout title={title} description={description} schema={schema} image={d.image}>
  <Header />
  <main>
    <article class="tool">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span>
          {cat && <><a href={`/category/${cat.slug}/`}>{cat.name}</a> <span aria-hidden="true">/</span></>}
          <span>{d.name}</span>
        </nav>

        <header class="tool-head glass">
          <div class="th-main">
            {cat && <a class="th-cat" href={`/category/${cat.slug}/`}>{cat.icon} {cat.name}{sub && ` · ${sub.name}`}</a>}
            <h1 class="th-name">{d.name}{d.featured && <span class="pick" title="Editor’s pick">★</span>}</h1>
            <p class="th-tag">{d.tagline}</p>
            {words > 400 && <p class="th-read">{readingTime} min read · updated {(d.updated ?? new Date()).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</p>}
            {d.tags.length > 0 && (
              <ul class="th-tags" role="list">{d.tags.map((t) => <li>#{t}</li>)}</ul>
            )}
          </div>
          <a class="th-visit btn btn-primary" href={d.url} target="_blank" rel={outboundRel(d.url, d.affiliate)}>
            Visit {d.name}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </header>

        {toc.length > 3 && (
          <nav class="toc glass" aria-label="Table of contents">
            <p class="toc-title">On this page</p>
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </nav>
        )}

        <div class="prose">
          <Content />
        </div>

        <a class="cta-visit btn btn-ghost" href={d.url} target="_blank" rel={outboundRel(d.url, d.affiliate)}>
          Open {d.name} in a new tab ↗
        </a>

        {related.length > 0 && (
          <section class="related">
            <h2>More in {sub?.name ?? cat?.name}</h2>
            <ul role="list">
              {related.map((r) => (
                <li class="glass">
                  <a class="r-name" href={`/tools/${r.id}/`}>{r.data.name}</a>
                  <p class="r-tag">{r.data.tagline}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        <p class="back"><a href="/#directory">← Back to the directory</a></p>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .tool { padding-block: clamp(1.5rem, 5vw, 2.5rem) clamp(2rem, 6vw, 3.5rem); }
  .crumbs { font-size: 0.85rem; color: var(--text-faint); margin-bottom: 1.2rem; }
  .crumbs a { color: var(--cyan-soft); }
  .crumbs span { margin-inline: 0.35rem; }

  .tool-head { padding: 1.5rem; display: grid; gap: 1.2rem; }
  .th-cat { font-family: var(--font-head); font-weight: 600; font-size: 0.85rem; color: var(--cyan-soft); }
  .th-name { font-size: clamp(1.8rem, 1.3rem + 3vw, 2.7rem); margin-top: 0.5rem; display: inline-flex; align-items: center; gap: 0.4rem; }
  .pick { color: var(--orange); font-size: 0.7em; }
  .th-tag { color: var(--text-dim); font-size: 1.1rem; margin-top: 0.5rem; }
  .th-read { color: var(--text-faint); font-size: 0.85rem; margin-top: 0.5rem; }
  .th-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
  .th-tags li { font-size: 0.76rem; color: var(--text-faint); background: rgba(112,243,255,.05); border: 1px solid var(--glass-border); padding: 0.2rem 0.6rem; border-radius: 999px; }
  .th-visit { justify-self: start; }

  /* Table of contents */
  .toc { padding: 1.1rem 1.3rem; margin-top: 1.6rem; }
  .toc-title { font-family: var(--font-head); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 0.7rem; }
  .toc ul { list-style: none; display: grid; gap: 0.45rem; }
  .toc a { color: var(--text-dim); font-size: 0.95rem; }
  .toc a:hover { color: var(--cyan-soft); }

  /* Prose (markdown article) */
  .prose { max-width: 72ch; margin-block: 2.2rem; color: var(--text); font-size: 1.05rem; }
  .prose :global(h2) { font-size: 1.6rem; margin-top: 2.2rem; margin-bottom: 0.7rem; scroll-margin-top: 80px; }
  .prose :global(h3) { font-size: 1.25rem; margin-top: 1.6rem; margin-bottom: 0.5rem; }
  .prose :global(p) { color: var(--text-dim); margin-bottom: 1rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; margin-bottom: 1rem; display: grid; gap: 0.45rem; }
  .prose :global(li) { color: var(--text-dim); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(a) { color: var(--cyan-soft); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(blockquote) { border-left: 3px solid var(--cyan); padding: 0.6rem 1rem; margin: 1.3rem 0; background: rgba(0,240,255,.05); border-radius: 0 10px 10px 0; color: var(--text-dim); }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.2rem 0; font-size: 0.95rem; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--glass-border); padding: 0.6rem 0.8rem; text-align: left; }
  .prose :global(th) { color: var(--text); font-family: var(--font-head); background: rgba(112,243,255,.05); }
  .prose :global(td) { color: var(--text-dim); }
  .prose :global(hr) { border: none; border-top: 1px solid var(--glass-border); margin: 2rem 0; }
  .prose :global(code) { background: rgba(112,243,255,.08); border: 1px solid var(--glass-border); border-radius: 6px; padding: 0.1rem 0.4rem; font-size: 0.9em; }

  .cta-visit { margin-bottom: 2.5rem; }

  .related { margin-top: 1rem; }
  .related h2 { font-size: 1.3rem; margin-bottom: 1rem; }
  .related ul { list-style: none; display: grid; gap: 0.8rem; grid-template-columns: 1fr; }
  .related li { padding: 1rem 1.1rem; transition: border-color .2s, box-shadow .2s; }
  .related li:hover { border-color: var(--glass-border-strong); box-shadow: var(--glow-cyan); }
  .r-name { font-family: var(--font-head); font-weight: 700; }
  .r-name:hover { color: var(--cyan-soft); }
  .r-tag { color: var(--text-dim); font-size: 0.88rem; margin-top: 0.3rem; }

  .back { margin-top: 2.2rem; }
  .back a { color: var(--cyan-soft); font-weight: 600; }

  @media (min-width: 720px) {
    .tool-head { grid-template-columns: 1fr auto; align-items: center; }
    .th-visit { justify-self: end; }
    .related ul { grid-template-columns: 1fr 1fr; }
  }
</style>
