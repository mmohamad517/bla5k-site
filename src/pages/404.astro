---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Page Not Found (404) | bla5k"
  description="Sorry, the page you’re looking for doesn’t exist. Explore the bla5k directory instead."
  noindex={true}
>
  <Header />
  <main>
    <section class="nf">
      <div class="container">
        <p class="code grad">404</p>
        <h1 class="nf-title">This page took a wrong turn</h1>
        <p class="nf-lead">The page you’re looking for doesn’t exist or has moved. But there’s plenty more to discover.</p>
        <div class="nf-actions">
          <a href="/" class="btn btn-primary">Back to home</a>
          <a href="/#directory" class="btn btn-ghost">Browse the directory</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .nf { text-align: center; padding-block: clamp(3rem, 12vw, 6rem); }
  .code { font-family: var(--font-head); font-weight: 800; font-size: clamp(5rem, 18vw, 10rem); line-height: 1; }
  .nf-title { font-size: clamp(1.6rem, 1.2rem + 3vw, 2.6rem); margin-block: 0.5rem 0.8rem; }
  .nf-lead { color: var(--text-dim); max-width: 46ch; margin: 0 auto 2rem; font-size: 1.1rem; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; }
</style>
